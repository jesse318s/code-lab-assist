{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".github/copilot-instructions.md"],
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "agents": {
    "debugger": {
      "system": "{file:../.github/agents/debugger.md}"
    },
    "poml-prompt-engineer": {
      "system": "{file:../.github/agents/poml-prompt-engineer.md}"
    }
  },
  "mcp": {
    "servers": {
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "disabled": true,
        "headers": {
          "Authorization": "Bearer {file:~/.secrets/github_token.txt}"
        }
      }
    }
  }
}
